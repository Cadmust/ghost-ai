// Project model
model Project {
  id        String   @id @default(uuid())
  ownerId   String   // Maps to Clerk user ID
  name      String
  description String?
  status    ProjectStatus @default(DRAFT)
  canvasJsonPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  collaborators ProjectCollaborator[] @relation("ProjectCollaborators")
  specs     ProjectSpec[] @relation("ProjectSpecs")

  @@index([ownerId])
  @@index([createdAt])
}

// ProjectCollaborator model
model ProjectCollaborator {
  id        String   @id @default(uuid())
  project   Project  @relation("ProjectCollaborators", fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}

// Project status enum
enum ProjectStatus {
  DRAFT
  ARCHIVED
}