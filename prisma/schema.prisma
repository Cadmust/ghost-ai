// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Project model
model Project {
  id        String   @id @default(uuid())
  ownerId   String   // Maps to Clerk user ID
  name      String
  description String?
  status    ProjectStatus @default(DRAFT)
  canvasJsonPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  collaborators ProjectCollaborator[] @relation("ProjectCollaborators")

  @@index([ownerId])
  @@index([createdAt])
}

// ProjectCollaborator model
model ProjectCollaborator {
  id        String   @id @default(uuid())
  project   Project  @relation("ProjectCollaborators", fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  email     String
  createdAt DateTime @default(now())

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}

// Project status enum
enum ProjectStatus {
  DRAFT
  ARCHIVED
}
